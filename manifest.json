{
  "name": "AIWorkspaces",
  "version": "0.3.0",
  "author": "dcqwqc",
  "homepage": "https://github.com/dcqwqc/CaelestiaPlugin-AIWorkspaces",
  "icon": "smart_toy",
  "description": "Isolated graphical AI workspaces with a compact native QuickShell preview dock (optional detached floating card).",
  "entryPoints": [
    {
      "type": "custom",
      "source": "Main.qml"
    },
    {
      "type": "shell-panel",
      "source": "ui/Panel.qml",
      "properties": {
        "edge": "top",
        "alignment": "left",
        "interactive": true,
        "deformAmount": 0
      }
    }
  ],
  "settings": "Settings.qml"
}
